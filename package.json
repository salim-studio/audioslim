    "test:watch": "vitest",
    "build:wasm": "node tools/build-wasm.mjs",
    "check:licenses": "node tools/check-licenses.mjs",
    "prebuild": "npm run check:licenses"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "lucide": "1.54.0"
  },
  "devDependencies": {
    "jsdom": "30.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
