{
  "name": "audioslim",
  "version": "2.0.0",
  "description": "audioslim+: a waveform and multitrack audio editor in your browser. Record, edit, restore, mix and master audio on your own device.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
